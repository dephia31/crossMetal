# CrossMetal sdkconfig defaults for the Metalio E-Ink4-Plus.
#
# Values transcribed from the upstream hardware repository's
# sdkconfig.defaults / sdkconfig.defaults.esp32s31 and sdkconfig
# (https://github.com/CloudZao/Metalio-E-INK4-Plus, MIT).
#
# Getting these wrong is the fastest route to a boot loop, so each block notes
# what breaks without it.

# --- Target ------------------------------------------------------------------
# ESP32-S31, RISC-V. NOT esp32s3.
CONFIG_IDF_TARGET="esp32s31"

# --- Flash: 16 MB, DIO (not QIO), 80 MHz -------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y

# --- PSRAM: Octal, 200 MHz ---------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Runs a full PSRAM test at boot. Upstream keeps it on; leaving it on means a bad
# PSRAM part fails loudly at boot instead of corrupting frames later.
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Enable stack in PSRAM. The Kconfig was renamed from SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY
# to FREERTOS_TASK_CREATE_ALLOW_EXT_MEM in IDF 6.x; the old name is an alias.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# --- CPU ---------------------------------------------------------------------
# 320 MHz, matching upstream sdkconfig for this board.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=320

# --- Partition table ---------------------------------------------------------
# The upstream 16 MB layout, including the 5 MB font_data partition the reader
# uses for its bitmap UI font.
# Offset is 0x8000, matching upstream sdkconfig. The CSV's first entry (nvs)
# sits at 0x9000, exactly one sector later, which is what keeps them from
# overlapping.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_metalio.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_metalio.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- FreeRTOS ----------------------------------------------------------------
# 100 Hz, matching upstream. Anything else changes every pdMS_TO_TICKS() in the
# ported drivers, several of which were tuned against upstream's tick rate.
CONFIG_FREERTOS_HZ=100

# --- Power management --------------------------------------------------------
# Upstream enables this; the light-sleep/standby policy depends on it.
CONFIG_PM_ENABLE=y
CONFIG_PM_SLP_DISABLE_GPIO=n

# --- Task watchdog -----------------------------------------------------------
# 20 s, matching upstream. The 5 s default trips during a full e-paper refresh,
# which legitimately blocks a core for seconds at a time.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20

# --- Logging -----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Compiler ----------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# --- Heap --------------------------------------------------------------------
CONFIG_HEAP_TRACING_OFF=y